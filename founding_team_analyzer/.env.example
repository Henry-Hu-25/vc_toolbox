# Required
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# Optional overrides
FTA_MODEL_REASONING=gpt-5.5
FTA_MODEL_EXTRACT=gpt-5.5
FTA_REASONING_EFFORT=medium   # none | low | medium | high | xhigh
FTA_EXTRACT_EFFORT=low
FTA_MAX_FOUNDERS=5
FTA_MAX_TAVILY_PER_FOUNDER=8
FTA_MAX_EXTRACTS_PER_FOUNDER=4
FTA_MAX_LLM_CALLS=30
FTA_HTTP_TIMEOUT=15
FTA_OUTPUT_DIR=./out
